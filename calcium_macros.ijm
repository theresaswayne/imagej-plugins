{Macros for analyzing calcium imaging data}{By T. Swayne for E. Fiorica-Howells, May 2000}procedure CheckForStack;begin  if nPics=0 then begin    PutMessage('This macro requires a stack.');    exit;  end;  if nSlices=0 then begin    PutMessage('This window is not a stack.');    exit  end;end;macro 'Invert Values';var  i:integer;beginfor i:= 1 to nSlices do begin    SelectSlice(i);    Invert;  end;end;macro 'Color-Coding';begin  CheckForStack;  SetPalette('Rainbow',0);end;macro 'Measure Stack';var  i:integer;begin  CheckForStack;  ResetCounter;  SetOptions('Mean');  for i:= 1 to nSlices do begin    SelectSlice(i);    Measure;  end;  ShowResults;end;